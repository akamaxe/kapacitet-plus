# Copy to .env (never commit .env).
# Optional: a personal ENTSO-E Transparency Platform token. With it, the spot prices of the
# weather years before 2023 come from ENTSO-E (the business case's range); without it prices come
# from elprisetjustnu.se (2023 onwards) only. Never commit, print or bundle the token.
ENTSOE_API_TOKEN=

# Optional: sign-in with the DSO's identity provider (OpenID Connect; docs/sso.md). Off unless
# KAPACITET_AUTH=oidc. The secrets go here or in the environment only, never in the repository.
KAPACITET_AUTH=
KAPACITET_OIDC_ISSUER=
KAPACITET_OIDC_CLIENT_ID=
KAPACITET_OIDC_CLIENT_SECRET=
# at least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
KAPACITET_SESSION_SECRET=
# Entra ID app role values to Kapacitet+ roles (planner, approver, admin, auditor)
KAPACITET_OIDC_ROLE_MAP=
