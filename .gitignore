__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.env
.venv/
# All of data/, whatever lands in it: downloads and results (reproducible with `python -m kapacitet
# all`, and derived from OpenStreetMap, so ODbL and published apart), assessments, the queue,
# applications and seals (data/requests/), imported networks and which one is in use (an operator's
# own data: data/datasets/, data/active.json), and anything a later stage or a crash leaves there.
# tests/test_no_data_committed.py fails if any of it is tracked all the same.
/data/
web/node_modules/
web/dist/
web/*.tsbuildinfo
# Design tooling: screenshots and working files of the taste and impeccable skills.
.taste-skill/
.impeccable/mocks/
.impeccable/live/
.impeccable/config.local.json
.impeccable/review/
# Playwright: the empty data folder of the CI project and the run reports
web/e2e/.empty-data/
web/test-results/
web/.shots/
web/playwright-report/

# data bundles are shared separately and never committed
*.zip
# nor is a private key, such as the seals' signing key (KAPACITET_HOME/keys)
*.pem
# Playwright: the data folder of the upload server, emptied at every run
web/e2e/.upload-data/
# a study holds a DSO's data and lives outside the repository (study/); never commit one
studies/
