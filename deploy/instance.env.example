# One Kapacitet+ installation for one DSO: every variable the server reads, with what it does.
#
# Copy this file outside the repository (for instance /etc/kapacitet/instance.env, readable only
# by the people who run the installation), fill it in and pass it with `docker run --env-file`, or
# export it before `python -m kapacitet serve`. It holds no secret as shipped: the lines marked
# SECRET are left empty here and get their values from the DSO's secret store at deploy time.
# Empty means "not set": the default in the comment applies. docs/deployment.md is the guide, and
# `python -m kapacitet instance check` says what is missing or wrong.

# ---------------------------------------------------------------- the server
# Where it listens. The container sets 0.0.0.0, which Docker needs to forward the port; publish the
# port on 127.0.0.1 only and put a reverse proxy with TLS in front.
KAPACITET_HOST=0.0.0.0
KAPACITET_PORT=8000
# The names the server answers to besides localhost, comma-separated: the public name the reverse
# proxy passes on. `*` turns the host check off and is reported as an error.
KAPACITET_ALLOWED_HOSTS=kapacitet.example-dso.se
# Origins of other sites that may call the API from a browser, comma-separated (none by default).
KAPACITET_CORS_ORIGINS=
# 0 runs the server without the supervisor that restarts it on another network (1 by default).
KAPACITET_SUPERVISE=

# ---------------------------------------------------------------- folders
# The data the engine reads and writes (processed/ and requests/); /app/data in the container.
KAPACITET_DATA_DIR=/app/data
# Where the imported networks (datasets/) and active.json live; the data folder by default.
KAPACITET_HOME=
# Downloaded sources (weather, prices, OSM); <data>/raw by default.
KAPACITET_RAW_DIR=
# The reference network's data, which a study's station reuses; KAPACITET_HOME by default.
KAPACITET_REFERENCE_DIR=
# The installation's Ed25519 seal key. Keep it on a volume of its own, apart from the data, owned
# by the server's user (uid 10001 in the container); <home>/keys by default.
KAPACITET_SEAL_KEY_DIR=/run/kapacitet/keys

# ---------------------------------------------------------------- the database
# PostgreSQL for the server's state instead of files under data/requests. One database per DSO.
# Give the role a password through ~/.pgpass or the URL (then this line is SECRET) and require TLS
# away from localhost: ?sslmode=verify-full.
KAPACITET_DATABASE_URL=postgresql://kapacitet@db.example-dso.se:5432/kapacitet?sslmode=verify-full
# The key of this data folder's rows; from the data folder by default ("main" for the reference).
KAPACITET_STORE_SCOPE=
# The folder holding pg_dump and pg_restore for `kapacitet instance backup|restore`, when they are
# not on the PATH. Use the client tools of the server's major version or later.
KAPACITET_PG_BIN=

# ---------------------------------------------------------------- sign-in (docs/sso.md)
# oidc turns sign-in on; off says, on purpose, that whoever reaches the server may use all of it.
# instance check reports an error while this is unset.
KAPACITET_AUTH=oidc
# The DSO's own app at its identity provider (Entra ID: https://login.microsoftonline.com/<tenant>/v2.0).
KAPACITET_OIDC_ISSUER=
KAPACITET_OIDC_CLIENT_ID=
# SECRET: the app's client secret.
KAPACITET_OIDC_CLIENT_SECRET=
# SECRET: at least 32 random characters that sign the session cookie.
KAPACITET_SESSION_SECRET=
# The claim the roles arrive in (roles), how provider values map to planner, approver, admin and
# auditor (Value=role,... or JSON), the scopes asked for (openid profile email), the callback URL
# (<the URL the browser used>/api/v1/auth/callback) and how long a session lasts (8 hours).
KAPACITET_OIDC_ROLE_CLAIM=
KAPACITET_OIDC_ROLE_MAP=
KAPACITET_OIDC_SCOPES=
KAPACITET_OIDC_REDIRECT_URI=
KAPACITET_SESSION_HOURS=

# ---------------------------------------------------------------- timestamps for the seal chain
# An RFC 3161 time-stamping authority; only the SHA-256 of each chain line is sent. Off when empty.
KAPACITET_TSA_URL=
# The TSA's certificate (PEM), downloaded once, that `kapacitet seals verify` checks tokens with.
KAPACITET_TSA_CERT=
# Seconds to wait for the TSA (5); a TSA that does not answer never holds a seal back.
KAPACITET_TSA_TIMEOUT_S=

# ---------------------------------------------------------------- telemetry
# off, console (spans to the log, for development) or otlp; with OTEL_EXPORTER_OTLP_ENDPOINT set
# and this empty, otlp. Off by default.
KAPACITET_TELEMETRY=
# The collector's OTLP/HTTP endpoint and the service name (kapacitet).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
# SECRET when the collector needs a token: standard OpenTelemetry headers, key=value,...
OTEL_EXPORTER_OTLP_HEADERS=

# ---------------------------------------------------------------- limits
# Live evaluations at once (4), waiting (8) and the seconds one may run (120).
KAPACITET_MAX_JOBS=
KAPACITET_MAX_QUEUED=
KAPACITET_JOB_TIMEOUT_S=
# Builds of imported networks at once (1) and the seconds one may run (14400).
KAPACITET_MAX_BUILDS=
KAPACITET_BUILD_TIMEOUT_S=
# Days a saved assessment is kept before the daily purge (kept for ever when empty).
KAPACITET_RETENTION_DAYS=

# ---------------------------------------------------------------- setup and the inbox
# 0 stops the worker that decides incoming applications by the DSO's rule (1).
KAPACITET_INBOX_WORKER=
# 1 lets an empty copy take its data bundle from the setup page; leave it off once the data are in.
KAPACITET_SETUP_UPLOAD=
# 1 takes any well-formed bundle on that page, not only the pinned data release.
KAPACITET_SETUP_ANY_BUNDLE=

# ---------------------------------------------------------------- data sources
# SECRET: an ENTSO-E Transparency Platform token for day-ahead prices (optional).
ENTSOE_API_TOKEN=
# Another neighbourhood of config/site.toml (the [site] table by default).
KAPACITET_SITE=
# Where `kapacitet study` keeps studies (~/kapacitet-studies).
KAPACITET_STUDY_DIR=

# Set by the application for its own child processes, never by hand: KAPACITET_SUPERVISED,
# KAPACITET_DATASET and KAPACITET_STUDY.
